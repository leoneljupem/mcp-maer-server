# 🦁 MAER MCP Server — Variables de Entorno
# Copia este archivo a .env y ajusta los valores
# NUNCA subas .env a git — ya está en .gitignore

# ══════════════════════════════════════════════════════
# 🤖 ANTHROPIC (OBLIGATORIO para el chat con Claude)
# ══════════════════════════════════════════════════════
# Obtén tu clave en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-PON_AQUI_TU_CLAVE_REAL

# ── API RENAPO (proxy CURP) ──
API_CURP_URL=https://api-curp-renapo.ejemplo.com/curp
API_CURP_TOKEN=PON_AQUI_TU_TOKEN

# ── OCR Config ──
# Motor OCR preferido: tesseract, easyocr, paddleocr, rapidocr, auto
MAER_OCR_ENGINE=auto
# Idiomas OCR (separados por +)
MAER_OCR_LANGS=spa+eng
# DPI para conversión PDF→imagen
MAER_OCR_DPI=300
# Máximo de páginas para OCR
MAER_OCR_MAX_PAGES=50

# ── OCR Pro — Motores Ensemble (opcionales, mejoran precisión) ──
# Instalar en maer_env (Intel Mac — respeta numpy 1.26.4 / torch 2.2.2):
#
#   RapidOCR (ONNX, sin GPU, muy rápido):
#     pip install rapidocr-onnxruntime --break-system-packages
#
#   EasyOCR (deep learning, buen español, sin GPU):
#     pip install easyocr --break-system-packages
#
#   PaddleOCR (estado del arte, multilingüe):
#     pip install paddlepaddle --break-system-packages
#     pip install paddleocr --break-system-packages
#
#   O instalar desde el dashboard MAER:
#     Pestaña Imágenes → OCR Pro → ⚙️ Motores → [Instalar]

# ── Web Dashboard ──
MAER_WEB_HOST=0.0.0.0
MAER_WEB_PORT=8765

# ── Seguridad ──
# Directorios excluidos de indexación (separados por ,)
MAER_EXCLUDED_DIRS=.git,.ssh,.gnupg,.aws,node_modules,__pycache__,.venv
