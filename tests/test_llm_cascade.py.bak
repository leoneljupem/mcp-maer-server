"""
test_llm_cascade.py — Tests de la cascada LLM de MAER
Leonel Houssen Mojica — Ecatepec MX — 2026

Prueba los motores Ollama, Groq, OpenAI y el diccionario local,
así como el endpoint /api/llm-status del servidor.
"""

import os
import sys

import pytest

# Asegurar que el paquete se puede importar desde la raíz del proyecto
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))


# ─── IMPORTS ──────────────────────────────────────────────────────────────────
from maer_backend.maer_files import (_MAER_SYSTEM_PROMPT,
                                     _llm_diccionario_local, action_llm_chat)

# ─── PROMPT SISTEMA ───────────────────────────────────────────────────────────


class TestSystemPrompt:
    def test_prompt_no_vacio(self):
        assert len(_MAER_SYSTEM_PROMPT) > 50

    def test_prompt_en_espanol(self):
        assert "español" in _MAER_SYSTEM_PROMPT.lower() or "IMSS" in _MAER_SYSTEM_PROMPT

    def test_prompt_menciona_imss(self):
        assert "IMSS" in _MAER_SYSTEM_PROMPT


# ─── DICCIONARIO LOCAL ────────────────────────────────────────────────────────


class TestDiccionarioLocal:
    """El diccionario local siempre funciona sin internet ni LLMs."""

    def test_responde_ley_73(self):
        res = _llm_diccionario_local("ley 73 semanas")
        assert res["ok"] is True
        assert res["engine"] == "local_diccionario"
        assert len(res["text"]) > 10

    def test_responde_ley_97(self):
        res = _llm_diccionario_local("ley 97 afore")
        assert res["ok"] is True

    def test_responde_curp(self):
        res = _llm_diccionario_local("¿cómo verifico mi curp?")
        assert res["ok"] is True
        assert res["text"]

    def test_responde_nss(self):
        res = _llm_diccionario_local("número de seguridad social")
        assert res["ok"] is True

    def test_responde_pension_vejez(self):
        res = _llm_diccionario_local("pensión de vejez 65 años")
        assert res["ok"] is True

    def test_responde_semanas(self):
        res = _llm_diccionario_local("¿cuántas semanas necesito?")
        assert res["ok"] is True

    def test_prompt_desconocido_tiene_respuesta(self):
        """Incluso preguntas sin match tienen una respuesta de fallback."""
        res = _llm_diccionario_local("xyzzy consulta sin match")
        assert res["ok"] is True
        assert res["text"]

    def test_engine_correcto(self):
        res = _llm_diccionario_local("imss pensión")
        assert res["engine"] == "local_diccionario"


# ─── ACTION LLM CHAT ─────────────────────────────────────────────────────────


class TestActionLlmChat:
    """Prueba el dispatcher action_llm_chat."""

    def test_prompt_vacio_no_crashea(self):
        """Prompt vacío cae al diccionario sin error."""
        res = action_llm_chat({"prompt": ""})
        assert res is not None

    def test_retorna_estructura_correcta(self):
        res = action_llm_chat({"prompt": "¿qué es el IMSS?", "motor": "diccionario"})
        assert "ok" in res
        assert res["data"] is not None or res.get("ok") is False

    def test_retorna_respuesta_en_data(self):
        res = action_llm_chat(
            {"prompt": "semanas cotizadas ley 73", "motor": "diccionario"}
        )
        data = res.get("data", {})
        assert "respuesta" in data or "response" in data

    def test_engine_presente_en_data(self):
        res = action_llm_chat(
            {"prompt": "CURP consulta RENAPO", "motor": "diccionario"}
        )
        data = res.get("data", {})
        assert "engine" in data

    def test_cascada_cae_a_diccionario(self):
        """Motor 'diccionario' devuelve siempre respuesta local inmediata."""
        res = action_llm_chat({"prompt": "pensión imss", "motor": "diccionario"})
        assert res is not None
        assert res.get("ok") is True
        engine = res.get("data", {}).get("engine", "")
        assert "diccionario" in engine or "local" in engine

    def test_motor_invalido_usa_cascada(self):
        """Un valor de motor inválido no debe romper la función."""
        # Con motor inválido entra a la cascada normal — devuelve algo
        res = action_llm_chat({"prompt": "NSS", "motor": "motor_inexistente"})
        assert res is not None

    def test_texto_contexto(self):
        """El parámetro texto se incluye como contexto en el prompt."""
        res = action_llm_chat(
            {
                "prompt": "¿cuántas semanas?",
                "texto": "Estado de cuenta IMSS con 500 semanas cotizadas.",
                "motor": "diccionario",
            }
        )
        assert res is not None
        assert res.get("ok") is True

    def test_prompt_largo_no_crashea(self):
        prompt = "pensión " * 500  # 3500 chars
        res = action_llm_chat({"prompt": prompt, "motor": "diccionario"})
        assert res is not None


# ─── OLLAMA (solo si está activo) ────────────────────────────────────────────


class TestOllamaIntegracion:
    """Tests de integración con Ollama — se saltan si no está activo."""

    @pytest.fixture(autouse=True)
    def skip_si_ollama_inactivo(self):
        try:
            from maer_backend.maer_ollama import servidor_activo

            if not servidor_activo(timeout=2):
                pytest.skip("Ollama no está corriendo")
        except Exception:
            pytest.skip("maer_ollama no disponible")

    def test_listar_modelos(self):
        from maer_backend.maer_ollama import listar_modelos_api

        modelos = listar_modelos_api()
        assert isinstance(modelos, list)

    def test_elegir_modelo(self):
        from maer_backend.maer_ollama import elegir_modelo, listar_modelos_api

        modelos = listar_modelos_api()
        if modelos:
            modelo = elegir_modelo(modelos)
            assert modelo is not None
            assert isinstance(modelo, str)

    def test_modelo_preferido_instalado(self):
        """qwen3.5 o deepseek-r1 o gemma3 deben estar en la lista."""
        from maer_backend.maer_ollama import listar_modelos_api

        modelos = listar_modelos_api()
        nombres = " ".join(m["name"] for m in modelos)
        tiene_preferido = any(
            p in nombres for p in ["qwen3", "deepseek", "gemma3", "llama3", "mistral"]
        )
        assert (
            tiene_preferido
        ), f"Ningún modelo preferido encontrado en: {nombres[:200]}"

    def test_chat_responde(self):
        """Chat básico con Ollama — timeout generoso para modelos grandes."""
        from maer_backend.maer_ollama import chat

        try:
            res = chat("¿Qué significa IMSS? Responde en una oración.", timeout=300)
            assert res["ok"] is True
            assert len(res["text"]) > 5
        except Exception as e:
            if "timed out" in str(e).lower() or "timeout" in str(e).lower():
                pytest.skip(f"Ollama tardó demasiado (modelo grande): {e}")
            raise

    def test_chat_con_system_prompt(self):
        """El prompt de sistema en español funciona."""
        from maer_backend.maer_ollama import chat

        try:
            res = chat(
                "¿Qué es el IMSS? Una oración.", system=_MAER_SYSTEM_PROMPT, timeout=300
            )
            assert res["ok"] is True
        except Exception as e:
            if "timed out" in str(e).lower() or "timeout" in str(e).lower():
                pytest.skip(f"Ollama tardó demasiado: {e}")
            raise

    def test_action_llm_chat_usa_ollama(self):
        """action_llm_chat con motor='ollama' devuelve respuesta de Ollama."""
        res = action_llm_chat(
            {
                "prompt": "¿Qué es el IMSS? Responde en una oración.",
                "motor": "ollama",
            }
        )
        if not res.get("ok"):
            # Si timeout, saltar en lugar de fallar
            msg = res.get("message", "")
            if "timeout" in msg.lower() or "timed out" in msg.lower():
                pytest.skip(f"Ollama timeout (modelo grande): {msg}")
        data = res.get("data", {})
        engine = data.get("engine", "")
        assert "ollama" in engine, f"Engine inesperado: {engine!r}. Respuesta: {res}"


# ─── GROQ (solo si hay GROQ_API_KEY) ─────────────────────────────────────────


class TestGroqIntegracion:
    """Tests de integración con Groq — se saltan si no hay clave."""

    @pytest.fixture(autouse=True)
    def skip_si_sin_clave(self):
        if not os.environ.get("GROQ_API_KEY", "").startswith("gsk_"):
            pytest.skip("GROQ_API_KEY no configurada")

    def test_groq_sdk_importa(self):
        from groq import Groq

        assert Groq is not None

    def test_groq_responde(self):
        from maer_backend.maer_files import _llm_groq

        res = _llm_groq("¿Qué es el IMSS en una línea?")
        assert res["ok"] is True
        assert len(res["text"]) > 5
        assert "groq" in res["engine"]

    def test_groq_responde_en_espanol(self):
        from maer_backend.maer_files import _llm_groq

        res = _llm_groq(
            "¿Cuántas semanas cotizadas necesito para pensionarme bajo Ley 73?"
        )
        assert res["ok"] is True
        # La respuesta debe ser en español (verificamos caracteres latinos comunes)
        texto = res["text"].lower()
        assert any(c in texto for c in ["semana", "imss", "pensión", "cotizada", "año"])

    def test_groq_model_env(self):
        from maer_backend.maer_files import _llm_groq

        os.environ["GROQ_MODEL"] = "llama-3.3-70b-versatile"
        res = _llm_groq("IMSS")
        assert "llama-3.3-70b-versatile" in res["engine"]


# ─── PREFERENCIA MODELOS ──────────────────────────────────────────────────────


class TestPreferenciaModelos:
    def test_qwen35_en_preferencia(self):
        from maer_backend.maer_ollama import PREFERENCIA_MODELOS

        assert "qwen3.5" in PREFERENCIA_MODELOS

    def test_deepseek_en_preferencia(self):
        from maer_backend.maer_ollama import PREFERENCIA_MODELOS

        assert "deepseek-r1" in PREFERENCIA_MODELOS

    def test_gemma3_en_preferencia(self):
        from maer_backend.maer_ollama import PREFERENCIA_MODELOS

        assert "gemma3" in PREFERENCIA_MODELOS

    def test_qwen35_es_ultimo(self):
        """qwen3.5 es thinking model — debe aparecer DESPUÉS de llama3.3."""
        from maer_backend.maer_ollama import PREFERENCIA_MODELOS

        idx_qwen = PREFERENCIA_MODELOS.index("qwen3.5")
        idx_llama = PREFERENCIA_MODELOS.index("llama3.3")
        assert idx_qwen > idx_llama


# ─── API ENDPOINT LLM-STATUS ─────────────────────────────────────────────────


class TestApiLlmStatus:
    """Tests del endpoint /api/llm-status (requiere servidor activo)."""

    @pytest.fixture(autouse=True)
    def skip_si_servidor_inactivo(self):
        try:
            import httpx

            r = httpx.get("http://localhost:8765/api/status", timeout=3)
            if r.status_code != 200:
                pytest.skip("Servidor MAER no activo en puerto 8765")
        except Exception:
            pytest.skip("Servidor MAER no activo en puerto 8765")

    def test_endpoint_responde(self):
        import httpx

        r = httpx.get("http://localhost:8765/api/llm-status", timeout=8)
        assert r.status_code == 200

    def test_estructura_respuesta(self):
        import httpx

        r = httpx.get("http://localhost:8765/api/llm-status", timeout=8)
        body = r.json()
        data = body.get("data", {})
        assert "ollama" in data
        assert "groq" in data
        assert "openai" in data
        assert "motor_recomendado" in data

    def test_ollama_campo_disponible(self):
        import httpx

        r = httpx.get("http://localhost:8765/api/llm-status", timeout=8)
        data = r.json().get("data", {})
        assert "disponible" in data["ollama"]

    def test_motor_recomendado_no_nulo(self):
        import httpx

        r = httpx.get("http://localhost:8765/api/llm-status", timeout=8)
        data = r.json().get("data", {})
        assert data["motor_recomendado"] is not None


# ─── PODER IA — PLANTILLAS IMSS ──────────────────────────────────────────────


class TestPoderIAPlantillas:
    """
    Verifica que las plantillas del módulo Análisis IA (maer.poder.js)
    devuelven respuestas coherentes a través del diccionario local.
    Ninguno de estos tests requiere Ollama/Groq/Internet.
    """

    PLANTILLAS = {
        "semanas": (
            "Tengo las siguientes semanas cotizadas en el IMSS. "
            "¿Cuántas necesito para pensionarme por Ley 73 o Ley 97?"
        ),
        "pension": ("Quiero calcular mi pensión IMSS. Tengo 500 semanas cotizadas."),
        "documentos": ("¿Qué documentos necesito para tramitar mi pensión en el IMSS?"),
        "curp": ("CURP: HEGM560427HVZRRL04 — explícame qué información contiene."),
        "expediente": (
            "Este es el estado actual de mi expediente IMSS. ¿Qué me falta?"
        ),
    }

    def _chat(self, prompt):
        return action_llm_chat({"prompt": prompt, "motor": "diccionario"})

    def test_semanas_responde(self):
        res = self._chat(self.PLANTILLAS["semanas"])
        assert res["ok"] is True
        assert len(res["data"]["respuesta"]) > 10

    def test_pension_responde(self):
        res = self._chat(self.PLANTILLAS["pension"])
        assert res["ok"] is True

    def test_documentos_responde(self):
        res = self._chat(self.PLANTILLAS["documentos"])
        assert res["ok"] is True

    def test_curp_responde(self):
        res = self._chat(self.PLANTILLAS["curp"])
        assert res["ok"] is True

    def test_expediente_responde(self):
        res = self._chat(self.PLANTILLAS["expediente"])
        assert res["ok"] is True

    def test_respuesta_tiene_clave_respuesta(self):
        """Ambas claves 'respuesta' y 'response' deben existir."""
        res = self._chat("pensión imss")
        data = res.get("data", {})
        assert "respuesta" in data
        assert "response" in data
        assert data["respuesta"] == data["response"]

    def test_todas_retornan_engine_local(self):
        for nombre, prompt in self.PLANTILLAS.items():
            res = self._chat(prompt)
            engine = res.get("data", {}).get("engine", "")
            assert (
                "diccionario" in engine or "local" in engine
            ), f"Plantilla '{nombre}': engine inesperado '{engine}'"


# ─── SERVER-INFO (solo si hay servidor) ──────────────────────────────────────


class TestServerInfo:
    """Tests del endpoint /api/server-info."""

    @pytest.fixture(autouse=True)
    def skip_si_servidor_inactivo(self):
        try:
            import httpx

            r = httpx.get("http://localhost:8765/api/status", timeout=3)
            if r.status_code != 200:
                pytest.skip("Servidor MAER no activo en puerto 8765")
        except Exception:
            pytest.skip("Servidor MAER no activo en puerto 8765")

    def test_endpoint_responde(self):
        import httpx

        r = httpx.get("http://localhost:8765/api/server-info", timeout=5)
        assert r.status_code == 200

    def test_estructura_respuesta(self):
        import httpx

        r = httpx.get("http://localhost:8765/api/server-info", timeout=5)
        data = r.json().get("data", {})
        assert "ip_local" in data
        assert "puerto" in data
        assert "tasker_url" in data

    def test_tasker_url_tiene_endpoint(self):
        import httpx

        r = httpx.get("http://localhost:8765/api/server-info", timeout=5)
        tasker_url = r.json().get("data", {}).get("tasker_url", "")
        assert "tasker-receive" in tasker_url
