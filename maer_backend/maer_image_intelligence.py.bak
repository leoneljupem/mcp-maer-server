#!/usr/bin/env python3
# 🦁 MAER Image Intelligence — Análisis exhaustivo de imágenes
# Leonel Mojica — Ecatepec MX — 2026

"""
Extrae toda la información posible de una imagen usando:
  - EXIF / metadatos (piexif, exifread)
  - Códigos QR y barras (pyzbar)
  - Preprocesado avanzado (albumentations, Wand/ImageMagick)
  - Análisis de layout (layoutparser)
  - Extracción estructurada (unstructured)
  - Clasificación del documento (timm + reglas)
"""

import logging
import tempfile
from pathlib import Path
from typing import Optional

import numpy as np
from PIL import Image

logger = logging.getLogger("maer.img_intel")


# ═══════════════════════════════════════════════════════════════════════════════
# EXIF — metadatos de la imagen
# ═══════════════════════════════════════════════════════════════════════════════


def extract_exif(path: Path) -> dict:
    """Lee todos los metadatos EXIF de una imagen (JPG, TIFF, HEIF)."""
    result = {"ok": False, "metadata": {}, "orientation": None, "gps": None}
    try:
        import exifread

        with open(str(path), "rb") as f:
            tags = exifread.process_file(f, details=False)
        meta = {}
        for k, v in tags.items():
            clean_key = (
                k.replace("EXIF ", "").replace("Image ", "").replace("GPS ", "gps_")
            )
            meta[clean_key] = str(v)

        result["metadata"] = meta
        result["ok"] = True

        # Orientación para corrección automática
        orient_tag = tags.get("Image Orientation")
        if orient_tag:
            result["orientation"] = str(orient_tag)

        # GPS si existe
        lat = tags.get("GPS GPSLatitude")
        lon = tags.get("GPS GPSLongitude")
        if lat and lon:
            result["gps"] = {"lat": str(lat), "lon": str(lon)}

    except ImportError:
        result["error"] = "exifread no instalado"
    except Exception as e:
        result["error"] = str(e)

    # Complementar con piexif para datos adicionales
    try:
        import piexif

        exif_data = piexif.load(str(path))
        extra = {}
        ifd_map = {
            "0th": piexif.ImageIFD,
            "Exif": piexif.ExifIFD,
        }
        for ifd_name, ifd in ifd_map.items():
            for tag_id, val in (exif_data.get(ifd_name) or {}).items():
                try:
                    tag_name = (
                        piexif.TAGS[ifd_name].get(tag_id, {}).get("name", str(tag_id))
                    )
                    if isinstance(val, bytes):
                        try:
                            val = val.decode("utf-8", errors="ignore").strip("\x00")
                        except Exception:
                            val = val.hex()
                    extra[tag_name] = val
                except Exception:
                    pass
        result["metadata"].update(extra)
        result["ok"] = True
    except Exception:
        pass

    return result


# ═══════════════════════════════════════════════════════════════════════════════
# QR y códigos de barras
# ═══════════════════════════════════════════════════════════════════════════════


def detect_barcodes_qr(path: Path) -> dict:
    """
    Detecta y decodifica todos los códigos QR y barras en la imagen.
    Retorna lista de {type, data, rect} por cada código encontrado.
    """
    result = {"ok": False, "codes": [], "count": 0}
    try:
        import cv2
        from pyzbar.pyzbar import decode as pyzbar_decode

        img_bgr = cv2.imread(str(path))
        if img_bgr is None:
            # Intentar con PIL
            pil_img = Image.open(str(path)).convert("RGB")
            img_bgr = np.array(pil_img)[:, :, ::-1].copy()

        # Escala de grises para mejor detección
        gray = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2GRAY)

        codes_found = []
        for scale in [1.0, 1.5, 2.0]:
            if scale != 1.0:
                h, w = gray.shape
                scaled = cv2.resize(gray, (int(w * scale), int(h * scale)))
            else:
                scaled = gray

            decoded = pyzbar_decode(scaled)
            for d in decoded:
                data = d.data.decode("utf-8", errors="replace")
                rect = d.rect
                entry = {
                    "type": d.type,
                    "data": data,
                    "rect": {
                        "left": rect.left,
                        "top": rect.top,
                        "width": rect.width,
                        "height": rect.height,
                    },
                    "scale": scale,
                }
                # Deduplicar por contenido
                if not any(c["data"] == data for c in codes_found):
                    codes_found.append(entry)

        result["codes"] = codes_found
        result["count"] = len(codes_found)
        result["ok"] = True

        # Extraer datos estructurados si parece CURP o NSS
        for code in codes_found:
            data = code["data"].strip().upper()
            import re

            if re.match(r"^[A-Z]{4}\d{6}[HM][A-Z]{5}[A-Z0-9]\d$", data):
                code["tipo"] = "CURP"
            elif re.match(r"^\d{11}$", data):
                code["tipo"] = "NSS_IMSS"
            elif re.match(r"^[A-Z]{4}\d{6}[A-Z0-9]{3}$", data):
                code["tipo"] = "RFC"
            else:
                code["tipo"] = "GENERAL"

    except ImportError:
        result["error"] = "pyzbar no instalado (brew install zbar)"
    except Exception as e:
        logger.error(f"Error barcode/QR: {e}")
        result["error"] = str(e)

    return result


# ═══════════════════════════════════════════════════════════════════════════════
# Preprocesado avanzado con albumentations
# ═══════════════════════════════════════════════════════════════════════════════


def preprocess_albumentations(
    img: Image.Image, profile: str = "document"
) -> Image.Image:
    """
    Aplica pipeline de preprocesado optimizado para OCR.
    profiles: document | photo | scan | auto
    """
    try:
        import albumentations as A

        img_array = np.array(img.convert("RGB"))

        if profile == "scan":
            transform = A.Compose(
                [
                    A.ToGray(p=1.0),
                    A.CLAHE(clip_limit=3.0, tile_grid_size=(8, 8), p=1.0),
                    A.Sharpen(alpha=(0.3, 0.6), lightness=(0.8, 1.2), p=0.8),
                    A.GaussianBlur(blur_limit=(1, 3), p=0.3),
                ]
            )
        elif profile == "photo":
            transform = A.Compose(
                [
                    A.CLAHE(clip_limit=2.0, p=1.0),
                    A.Sharpen(alpha=(0.2, 0.5), p=0.7),
                    A.RandomBrightnessContrast(
                        brightness_limit=0.1, contrast_limit=0.2, p=0.5
                    ),
                ]
            )
        else:  # document / auto
            transform = A.Compose(
                [
                    A.CLAHE(clip_limit=2.5, tile_grid_size=(8, 8), p=1.0),
                    A.Sharpen(alpha=(0.2, 0.4), lightness=(0.9, 1.1), p=0.6),
                ]
            )

        augmented = transform(image=img_array)["image"]
        return Image.fromarray(augmented)

    except ImportError:
        return img
    except Exception as e:
        logger.debug(f"albumentations preprocesado falló: {e}")
        return img


# ═══════════════════════════════════════════════════════════════════════════════
# Preprocesado con Wand/ImageMagick — corrección de imágenes complejas
# ═══════════════════════════════════════════════════════════════════════════════


def preprocess_wand(path: Path, output_path: Path = None) -> Optional[Path]:
    """
    Usa ImageMagick (Wand) para preprocesar imágenes difíciles:
    deskew, denoise, auto-level, aumentar contraste.
    Retorna path de la imagen preprocesada.
    """
    try:
        from wand.image import Image as WandImage

        out = output_path or Path(tempfile.mktemp(suffix=".png"))

        with WandImage(filename=str(path)) as img:
            img.auto_orient()  # Corregir orientación EXIF
            img.deskew(0.4)  # Corregir inclinación (40% threshold)
            img.enhance()  # Reducir ruido
            img.auto_level()  # Normalizar niveles
            img.sharpen(radius=0, sigma=1.0)
            # Para imágenes en color, aumentar contraste
            if img.colorspace != "gray":
                img.contrast_stretch(
                    black_point=0.005 * img.width * img.height,
                    white_point=0.005 * img.width * img.height,
                )
            img.save(filename=str(out))

        return out

    except ImportError:
        logger.debug("Wand no disponible")
        return None
    except Exception as e:
        logger.error(f"Error Wand preprocesado: {e}")
        return None


# ═══════════════════════════════════════════════════════════════════════════════
# Análisis de layout con layoutparser
# ═══════════════════════════════════════════════════════════════════════════════


def analyze_layout(path: Path) -> dict:
    """
    Detecta regiones de texto, títulos, tablas e imágenes en el documento.
    Usa layoutparser con modelo ligero (sin detectron2).
    """
    result = {"ok": False, "blocks": [], "text_regions": 0}
    try:
        import cv2
        import layoutparser as lp

        img_bgr = cv2.imread(str(path))
        if img_bgr is None:
            pil_img = Image.open(str(path)).convert("RGB")
            img_bgr = np.array(pil_img)[:, :, ::-1].copy()

        # Modelo ligero basado en reglas (sin GPU, sin detectron2)
        lp.Detectron2LayoutModel.__new__(lp.Detectron2LayoutModel)

        # Fallback: usar segmentación propia por contraste y contornos
        gray = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2GRAY)
        _, binary = cv2.threshold(gray, 0, 255, cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU)
        contours, _ = cv2.findContours(
            binary, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE
        )

        blocks = []
        h_img, w_img = gray.shape
        for cnt in contours:
            x, y, w, h = cv2.boundingRect(cnt)
            area = w * h
            # Filtrar ruido (muy pequeños) y marco completo (muy grandes)
            if area < 500 or area > 0.9 * h_img * w_img:
                continue
            aspect = w / h if h > 0 else 0
            block_type = (
                "text" if aspect > 3 else ("table" if 0.5 < aspect < 3 else "image")
            )
            blocks.append(
                {
                    "type": block_type,
                    "x": x,
                    "y": y,
                    "w": w,
                    "h": h,
                    "area": area,
                }
            )

        blocks.sort(key=lambda b: (b["y"], b["x"]))
        result["blocks"] = blocks[:50]
        result["text_regions"] = sum(1 for b in blocks if b["type"] == "text")
        result["ok"] = True

    except Exception as e:
        logger.debug(f"layout analysis: {e}")
        result["error"] = str(e)

    return result


# ═══════════════════════════════════════════════════════════════════════════════
# Extracción estructurada con unstructured
# ═══════════════════════════════════════════════════════════════════════════════


def extract_with_unstructured(path: Path) -> dict:
    """
    Extrae texto y elementos estructurados (títulos, tablas, listas)
    usando la librería unstructured.
    """
    result = {"ok": False, "elements": [], "text": "", "tables": []}
    try:
        from unstructured.partition.auto import partition

        elements = partition(filename=str(path))
        text_parts = []
        tables = []

        for el in elements:
            el_type = type(el).__name__
            el_text = str(el).strip()
            if not el_text:
                continue

            result["elements"].append(
                {
                    "type": el_type,
                    "text": el_text[:500],
                }
            )

            if el_type == "Table":
                tables.append(el_text)
            else:
                text_parts.append(el_text)

        result["text"] = "\n".join(text_parts)
        result["tables"] = tables
        result["ok"] = True

    except ImportError:
        result["error"] = "unstructured no instalado"
    except Exception as e:
        logger.error(f"Error unstructured: {e}")
        result["error"] = str(e)

    return result


# ═══════════════════════════════════════════════════════════════════════════════
# Análisis completo de imagen
# ═══════════════════════════════════════════════════════════════════════════════


def analyze_image_full(path: Path, ocr: bool = True) -> dict:
    """
    Análisis exhaustivo de una imagen: EXIF, QR/barras, layout,
    preprocesado, OCR y clasificación del documento.
    """
    path = Path(path)
    if not path.exists():
        return {"ok": False, "error": f"Archivo no encontrado: {path}"}

    result = {
        "ok": True,
        "path": str(path),
        "file_name": path.name,
        "ext": path.suffix.lower(),
        "exif": {},
        "barcodes": [],
        "qr_codes": [],
        "layout": {},
        "text": "",
        "tables": [],
        "doc_type": "documento_general",
        "engine": "none",
        "quality": 0.0,
    }

    # 1) Metadatos EXIF
    exif = extract_exif(path)
    if exif.get("ok"):
        result["exif"] = exif.get("metadata", {})
        result["orientation"] = exif.get("orientation")

    # 2) QR y códigos de barras
    codes = detect_barcodes_qr(path)
    if codes.get("ok"):
        qr = [c for c in codes["codes"] if "QR" in c.get("type", "")]
        bars = [c for c in codes["codes"] if "QR" not in c.get("type", "")]
        result["qr_codes"] = qr
        result["barcodes"] = bars
        result["codes_found"] = codes["count"]

    # 3) Layout (solo para imágenes, no PDF en este módulo)
    if path.suffix.lower() in (".jpg", ".jpeg", ".png", ".bmp", ".tiff", ".tif"):
        layout = analyze_layout(path)
        result["layout"] = {
            "text_regions": layout.get("text_regions", 0),
            "total_blocks": len(layout.get("blocks", [])),
        }

    # 4) OCR avanzado
    if ocr:
        try:
            from maer_backend.maer_ocr_advanced import ocr_document_advanced

            ocr_result = ocr_document_advanced(path)
            result["text"] = ocr_result.get("text", "")
            result["engine"] = ocr_result.get("engine", "none")
            result["quality"] = ocr_result.get("quality", 0.0)
        except Exception as e:
            logger.error(f"OCR avanzado falló en analyze_image_full: {e}")

    # 5) Clasificación del documento
    if result["text"]:
        try:
            from maer_backend.maer_pdf_analyzer import classify_document

            result["doc_type"] = classify_document(result["text"])
        except Exception:
            pass

    # 6) unstructured para elementos estructurados adicionales
    if path.suffix.lower() == ".pdf":
        unst = extract_with_unstructured(path)
        if unst.get("ok") and unst.get("tables"):
            result["tables"] = unst["tables"]
        if unst.get("ok") and not result["text"]:
            result["text"] = unst.get("text", "")

    result["char_count"] = len(result["text"])
    result["has_codes"] = bool(result["barcodes"] or result["qr_codes"])
    return result


# ═══════════════════════════════════════════════════════════════════════════════
# Preprocesado turbo: Wand → albumentations → OCR
# ═══════════════════════════════════════════════════════════════════════════════


def preprocess_turbo(path: Path) -> Image.Image:
    """
    Pipeline de preprocesado máximo: Wand deskew+enhance → albumentations CLAHE+sharpen.
    Usar para imágenes muy difíciles donde el OCR normal falla.
    """
    try:
        # Wand: deskew y corrección de nivel
        wand_out = preprocess_wand(path)
        if wand_out and wand_out.exists():
            img = Image.open(str(wand_out)).convert("RGB")
        else:
            img = Image.open(str(path)).convert("RGB")

        # Albumentations: CLAHE + sharpen
        img = preprocess_albumentations(img, profile="scan")
        return img

    except Exception as e:
        logger.error(f"preprocess_turbo: {e}")
        return Image.open(str(path)).convert("RGB")
