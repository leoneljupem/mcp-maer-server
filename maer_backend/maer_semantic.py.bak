#!/usr/bin/env python3
# 🦁 MAER Semantic Search — Búsqueda por significado con embeddings
# Leonel Mojica — Ecatepec MX — 2026

"""
Motor de búsqueda semántica. Encuentra documentos por significado, no solo por
palabras exactas. "cuánto gané" encuentra "percepciones totales del período".

Motores (en orden de preferencia):
  1. sentence-transformers — paraphrase-multilingual-MiniLM-L12-v2 (120 MB)
  2. TF-IDF + scikit-learn — fallback sin descargas adicionales
"""

import json
import logging
import os
import pickle
from pathlib import Path
from typing import Optional

import numpy as np

logger = logging.getLogger("maer.semantic")

_MODEL_NAME = "paraphrase-multilingual-MiniLM-L12-v2"
_DEFAULT_INDEX_DIR = Path(os.environ.get("MAER_SEMANTIC_DIR", "data/semantic_index"))


class SemanticIndex:
    """Índice semántico para búsqueda por significado en documentos MAER."""

    def __init__(self, index_dir: Path = None):
        self.index_dir = Path(index_dir or _DEFAULT_INDEX_DIR)
        self.embeddings: Optional[np.ndarray] = None
        self.metadata: list = []
        self._model = None
        self._use_tfidf = False
        self._tfidf_vectorizer = None
        self._loaded = False

    # ── Motor de embeddings ──────────────────────────────────────────────────

    def _get_model(self):
        if self._model is not None:
            return self._model
        if self._use_tfidf:
            return None
        try:
            from sentence_transformers import SentenceTransformer

            logger.info(f"Cargando modelo semántico: {_MODEL_NAME}")
            self._model = SentenceTransformer(_MODEL_NAME)
            return self._model
        except ImportError:
            logger.warning(
                "sentence-transformers no disponible — usando TF-IDF como fallback"
            )
            self._use_tfidf = True
            return None
        except Exception as e:
            logger.warning(f"Error cargando modelo: {e} — usando TF-IDF")
            self._use_tfidf = True
            return None

    def _encode_batch(self, texts: list) -> np.ndarray:
        model = self._get_model()
        if model is not None:
            vecs = model.encode(texts, show_progress_bar=False, batch_size=32)
            return np.array(vecs, dtype=np.float32)
        # Fallback TF-IDF
        from sklearn.feature_extraction.text import TfidfVectorizer

        if self._tfidf_vectorizer is None:
            self._tfidf_vectorizer = TfidfVectorizer(
                max_features=15000,
                analyzer="word",
                ngram_range=(1, 2),
                sublinear_tf=True,
            )
            matrix = self._tfidf_vectorizer.fit_transform(texts)
        else:
            matrix = self._tfidf_vectorizer.transform(texts)
        return matrix.toarray().astype(np.float32)

    def _encode_query(self, query: str) -> np.ndarray:
        model = self._get_model()
        if model is not None:
            return model.encode([query], show_progress_bar=False)[0].astype(np.float32)
        if self._tfidf_vectorizer is None:
            raise ValueError("Índice no construido aún")
        vec = self._tfidf_vectorizer.transform([query])
        return vec.toarray()[0].astype(np.float32)

    # ── Construcción del índice ──────────────────────────────────────────────

    def build_from_index_file(self, index_json_path: Path) -> dict:
        """Construye el índice semántico desde maer_index.json."""
        if not index_json_path.exists():
            return {"ok": False, "error": f"Índice no existe: {index_json_path}"}

        try:
            with open(index_json_path, "r", encoding="utf-8") as f:
                entries = json.load(f)
        except Exception as e:
            return {"ok": False, "error": f"Error leyendo índice: {e}"}

        if not entries:
            return {"ok": False, "error": "Índice vacío"}

        texts, meta = [], []
        for entry in entries:
            snippet = str(entry.get("snippet") or "")
            path_str = str(entry.get("path") or "")
            if not snippet and not path_str:
                continue
            name = Path(path_str).name if path_str else ""
            combined = f"{name} {snippet}".strip()
            if not combined:
                continue
            texts.append(combined)
            meta.append(
                {
                    "path": path_str,
                    "ext": entry.get("ext", ""),
                    "size_bytes": entry.get("size_bytes", 0),
                    "snippet": snippet[:600],
                }
            )

        if not texts:
            return {"ok": False, "error": "Sin documentos con texto para indexar"}

        logger.info(f"Generando embeddings para {len(texts)} documentos...")
        try:
            embeddings = self._encode_batch(texts)
        except Exception as e:
            return {"ok": False, "error": f"Error generando embeddings: {e}"}

        self.embeddings = embeddings
        self.metadata = meta
        self._loaded = True

        # Persistir en disco
        self.index_dir.mkdir(parents=True, exist_ok=True)
        np.save(str(self.index_dir / "embeddings.npy"), self.embeddings)
        with open(self.index_dir / "metadata.json", "w", encoding="utf-8") as f:
            json.dump(meta, f, ensure_ascii=False)
        engine_name = "tfidf" if self._use_tfidf else "sentence-transformers"
        with open(self.index_dir / "config.json", "w", encoding="utf-8") as f:
            json.dump(
                {
                    "engine": engine_name,
                    "model": _MODEL_NAME if not self._use_tfidf else "tfidf",
                    "total_docs": len(texts),
                },
                f,
            )
        if self._use_tfidf and self._tfidf_vectorizer is not None:
            with open(self.index_dir / "tfidf_vectorizer.pkl", "wb") as f:
                pickle.dump(self._tfidf_vectorizer, f)

        logger.info(f"Índice semántico guardado en {self.index_dir} ({engine_name})")
        return {"ok": True, "total_docs": len(texts), "engine": engine_name}

    def build_from_documents(self, documents: list) -> dict:
        """
        Construye índice desde lista de dicts:
        [{"path": str, "text": str, "ext": str, "size_bytes": int}, ...]
        """
        if not documents:
            return {"ok": False, "error": "Lista vacía"}

        texts, meta = [], []
        for doc in documents:
            text = str(doc.get("text") or doc.get("snippet") or "").strip()
            path_str = str(doc.get("path") or "")
            if not text:
                continue
            name = Path(path_str).name if path_str else ""
            texts.append(f"{name} {text}".strip())
            meta.append(
                {
                    "path": path_str,
                    "ext": doc.get("ext", ""),
                    "size_bytes": doc.get("size_bytes", 0),
                    "snippet": text[:600],
                }
            )

        if not texts:
            return {"ok": False, "error": "Sin textos para indexar"}

        return self._save_built_index(texts, meta)

    def _save_built_index(self, texts: list, meta: list) -> dict:
        try:
            embeddings = self._encode_batch(texts)
        except Exception as e:
            return {"ok": False, "error": f"Error generando embeddings: {e}"}
        self.embeddings = embeddings
        self.metadata = meta
        self._loaded = True
        self.index_dir.mkdir(parents=True, exist_ok=True)
        np.save(str(self.index_dir / "embeddings.npy"), self.embeddings)
        with open(self.index_dir / "metadata.json", "w", encoding="utf-8") as f:
            json.dump(meta, f, ensure_ascii=False)
        engine_name = "tfidf" if self._use_tfidf else "sentence-transformers"
        with open(self.index_dir / "config.json", "w", encoding="utf-8") as f:
            json.dump({"engine": engine_name, "total_docs": len(texts)}, f)
        if self._use_tfidf and self._tfidf_vectorizer is not None:
            with open(self.index_dir / "tfidf_vectorizer.pkl", "wb") as f:
                pickle.dump(self._tfidf_vectorizer, f)
        return {"ok": True, "total_docs": len(texts), "engine": engine_name}

    # ── Carga del índice ─────────────────────────────────────────────────────

    def load(self) -> bool:
        """Carga el índice semántico desde disco."""
        emb_path = self.index_dir / "embeddings.npy"
        meta_path = self.index_dir / "metadata.json"
        if not emb_path.exists() or not meta_path.exists():
            return False
        try:
            self.embeddings = np.load(str(emb_path))
            with open(meta_path, "r", encoding="utf-8") as f:
                self.metadata = json.load(f)
            cfg_path = self.index_dir / "config.json"
            if cfg_path.exists():
                with open(cfg_path) as f:
                    cfg = json.load(f)
                if cfg.get("engine") == "tfidf":
                    self._use_tfidf = True
                    pkl_path = self.index_dir / "tfidf_vectorizer.pkl"
                    if pkl_path.exists():
                        with open(pkl_path, "rb") as f:
                            self._tfidf_vectorizer = pickle.load(f)
            self._loaded = True
            logger.info(f"Índice semántico cargado: {len(self.metadata)} documentos")
            return True
        except Exception as e:
            logger.error(f"Error cargando índice semántico: {e}")
            return False

    def is_ready(self) -> bool:
        if self._loaded and self.embeddings is not None:
            return True
        return self.load()

    # ── Búsqueda ─────────────────────────────────────────────────────────────

    def search(self, query: str, top_k: int = 10, min_score: float = 0.08) -> list:
        """
        Búsqueda semántica. Encuentra documentos con significado similar
        aunque no contengan las mismas palabras.
        Retorna lista ordenada por relevancia con score 0-1.
        """
        if not self.is_ready():
            return []

        try:
            q_emb = self._encode_query(query)
        except Exception as e:
            logger.error(f"Error codificando query: {e}")
            return []

        # Cosine similarity vectorizado
        norms_docs = np.linalg.norm(self.embeddings, axis=1, keepdims=True)
        norms_docs[norms_docs == 0] = 1.0
        normed_docs = self.embeddings / norms_docs

        q_norm = np.linalg.norm(q_emb)
        if q_norm == 0:
            return []
        q_normed = q_emb / q_norm

        scores = normed_docs @ q_normed
        top_indices = np.argsort(scores)[::-1][:top_k]

        results = []
        for idx in top_indices:
            score = float(scores[idx])
            if score < min_score:
                continue
            entry = self.metadata[idx].copy()
            entry["score"] = round(score, 4)
            entry["score_pct"] = f"{int(score * 100)}%"
            entry["snippet_preview"] = entry.get("snippet", "")[:300]
            results.append(entry)

        return results

    def hybrid_search(
        self,
        query: str,
        index_json_path: Path,
        top_k: int = 15,
        semantic_weight: float = 0.6,
    ) -> list:
        """
        Búsqueda híbrida: combina semántica + keyword exacta.
        semantic_weight=0.6 → 60% semántica, 40% keyword.
        """
        semantic_results = {r["path"]: r for r in self.search(query, top_k=top_k * 2)}

        # Keyword search sobre el mismo índice
        keyword_results = {}
        try:
            with open(index_json_path, "r", encoding="utf-8") as f:
                entries = json.load(f)
            q_lower = query.lower()
            for entry in entries:
                snippet = (entry.get("snippet") or "").lower()
                path_str = str(entry.get("path") or "")
                if q_lower in snippet or q_lower in path_str.lower():
                    keyword_results[path_str] = {
                        "path": path_str,
                        "ext": entry.get("ext", ""),
                        "size_bytes": entry.get("size_bytes", 0),
                        "snippet_preview": entry.get("snippet", "")[:300],
                        "score": 0.5,
                        "score_pct": "50%",
                        "match_type": "keyword",
                    }
        except Exception:
            pass

        # Combinar puntuaciones
        all_paths = set(list(semantic_results.keys()) + list(keyword_results.keys()))
        combined = []
        for path_str in all_paths:
            sem_score = semantic_results.get(path_str, {}).get("score", 0.0)
            kw_score = 0.5 if path_str in keyword_results else 0.0
            final_score = semantic_weight * sem_score + (1 - semantic_weight) * kw_score

            entry = semantic_results.get(path_str) or keyword_results.get(path_str)
            entry = entry.copy()
            entry["score"] = round(final_score, 4)
            entry["score_pct"] = f"{int(final_score * 100)}%"
            entry["match_type"] = (
                "híbrido"
                if path_str in semantic_results and path_str in keyword_results
                else ("semántico" if path_str in semantic_results else "keyword")
            )
            combined.append(entry)

        combined.sort(key=lambda x: x["score"], reverse=True)
        return combined[:top_k]

    def info(self) -> dict:
        if not self.is_ready():
            return {"ready": False, "total_docs": 0}
        engine = "tfidf" if self._use_tfidf else "sentence-transformers"
        return {
            "ready": True,
            "total_docs": len(self.metadata),
            "engine": engine,
            "model": _MODEL_NAME if not self._use_tfidf else "TF-IDF",
            "index_dir": str(self.index_dir),
        }


# Singleton global
_semantic_index: Optional[SemanticIndex] = None


def get_semantic_index(index_dir: Path = None) -> SemanticIndex:
    global _semantic_index
    if _semantic_index is None or (
        index_dir and index_dir != _semantic_index.index_dir
    ):
        _semantic_index = SemanticIndex(index_dir)
    return _semantic_index
